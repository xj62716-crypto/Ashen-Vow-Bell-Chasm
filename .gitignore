# Large review movies are delivered by an explicit manifest, not silently committed.
/deliverables/**/*.avi
/deliverables/**/*.mp4
/deliverables/**/*.mov

# Local full-frame capture intermediates. The encoded movies, state traces and
# delivery manifest are the review artifacts; source frames remain on this PC.
