/tools/reference-tools/
/tools/*.zip
/tools/*.7z
/tools/*.exe
/.tmp*
/.worktree-local.json
/WORKTREE_TASK.md

# Local production history is intentionally excluded from the playable source
# repository. Current runtime assets live under game/, while the adopted
# editable weapon sources live under assets/source/weapons/.
/docs/
/deliverables/
/tools/
/game/tests/
/AGENTS.md
/CONTEXT.md
/游戏设计与开发分块.md

